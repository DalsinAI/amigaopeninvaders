# What package/build-amiga.sh packs: the drawer, the make target that builds it, where it lands, the GFOpenUp part.
NAME=OpenInvaders
TARGET=all
DIST=build/amigaos
PART=OpenInvaders
ABOUT="Open Invaders: a Space Invaders style shooter with 15 levels, music and unlockables"
NEEDS=""
# The libraries the drawer carries in Libs/, built here at these commits
# (gfopenallegro #3: rc1's truecolour plus aldumb, bmp_read/write15-32,
# load_bitmap_font, make_trans_font and is_windowed_mode).
GFOPENALLEGRO_REF=65f2bc2a0e76e7a0bbdb85ecd684f2d1b7a3c78a
ACGAME_REF=f64352c980e26999d51661ec1bc6bb9cc047b977
